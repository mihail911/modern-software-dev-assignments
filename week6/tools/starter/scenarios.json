     "payment": "pay_1",
     "key": "k-1",
     "amount_minor": 1250,
     "currency": "USD"
    },
    {
     "at": 7,
     "do": "restart",
     "service": "api"
    },
    {
     "at": 8,
     "do": "pay",
     "merchant": "m_acme",
     "payment": "pay_1",
     "key": "k-1",
     "amount_minor": 1250,
     "currency": "USD"
    },
    {
     "at": 10,
     "do": "drain"
    }
   ],
   "expect": [
    {
     "payment": "pay_1",
     "endpoint": "ep_a",
     "events": 1
    }
   ],
   "unkeyed": []
  }
 ],
