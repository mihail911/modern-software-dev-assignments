#!/usr/bin/env python3
"""Build and start the four services in the background.

    bin/up [--state DIR]

State and logs go to DIR (default ./state). Stop them with bin/down.
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import replaylib  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--state", default=os.path.join(replaylib.APP, "state"))
    parser.add_argument("--port-base", type=int, default=int(os.environ.get("SWITCHYARD_PORT_BASE", "7100")))
    args = parser.parse_args()
    dep = replaylib.Deployment(os.path.abspath(args.state), args.port_base)
    dep.start_all()
    pids = {name: proc.pid for name, proc in dep.procs.items()}
    with open(os.path.join(dep.state, "pids.json"), "w", encoding="utf-8") as f:
        json.dump(pids, f)
    for name, offset in replaylib.OFFSET.items():
        print(f"{name:9s} http://127.0.0.1:{args.port_base + offset}  pid {pids[name]}")


if __name__ == "__main__":
    main()
