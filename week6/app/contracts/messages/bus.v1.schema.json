{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchyard.example/contracts/messages/bus.v1.schema.json",
  "title": "Bus message, version 1",
  "type": "object",
  "required": [
    "id",
    "merchant",
    "event_type",
    "amount",
    "currency",
    "payment",
    "ts"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "merchant": {
      "type": "string"
    },
    "event_type": {
      "enum": [
        "payment.captured",
        "payment.failed",
        "refund.created",
        "payout.paid"
      ]
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "Decimal string in the currency's major unit. README.md gives the digit rules."
    },
    "currency": {
      "enum": ["USD", "EUR", "GBP", "JPY", "KWD"]
    },
    "payment": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
